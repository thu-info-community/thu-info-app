<?xml version="1.0" encoding="utf-8"?>
<!-- WeekCard.ets legacyItemBlock() background. One level-list replaces 11
	per-color drawables: the renderer selects a color with
	ImageView.setImageLevel (index into WidgetPalette.HEXES), which RemoteViews
	can call on every API level (the legacy week card also runs pre-31). -->
<level-list xmlns:android="http://schemas.android.com/apk/res/android">
