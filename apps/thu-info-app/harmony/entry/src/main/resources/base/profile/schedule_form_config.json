      "updateDuration": 2,
      "isDefault": false,
      "resizable": true
    },
    {
      "name": "schedule_today",
      "displayName": "$string:widget_today_name",
      "description": "$string:widget_today_desc",
      "src": "./ets/widget/pages/TodayCard.ets",
      "uiSyntax": "arkts",
      "isDynamic": true,
      "colorMode": "auto",
      "supportDimensions": [
        "2*2",
        "2*4",
        "4*4"
      ],
      "defaultDimension": "2*4",
      "updateEnabled": true,
      "updateDuration": 4,
      "isDefault": true,
      "resizable": true
    },
    {
      "name": "schedule_week",
      "displayName": "$string:widget_week_name",
      "description": "$string:widget_week_desc",
      "src": "./ets/widget/pages/WeekCard.ets",
      "uiSyntax": "arkts",
      "isDynamic": true,
